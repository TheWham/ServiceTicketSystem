# ==============================================================================
# 服务器部署环境变量模板 — 复制为 .env 后填写，.env 永远不进 git
#   cp .env.example .env && chmod 600 .env
# 模型凭据（AI_BASE_URL / AI_API_KEY / EMBEDDING_API_KEY 等）只存在这个文件里。
# ==============================================================================

# ---------- GHCR 镜像前缀（必填）----------
# 格式：ghcr.io/<GitHub用户名小写>。例如仓库是 github.com/TheWham/ServiceTicketSystem
# 则填 ghcr.io/thewham（GHCR 要求全小写）
IMAGE_PREFIX=ghcr.io/<github用户名小写>

# ---------- MySQL（必填）----------
# MySQL 跑在服务器本机时保持 host.docker.internal（容器→宿主，不出公网）；
# 换真正的远程库时填远程地址
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DB=it_ticket_system
MYSQL_USERNAME=root
MYSQL_PASSWORD=<远程库密码>

# ---------- JWT 密钥（必填，gateway 校验登录态用）----------
# 长度至少 32 字节；本地 dev 默认值不要带上生产
JWT_SECRET=<至少32字节的随机串>

# ---------- Redis（服务器自建，密码必填）----------
REDIS_PASSWORD=<redis密码>

# ---------- 对话模型（consultation-service，AI 客服回答）----------
# base-url 填兼容接口根地址，不带 /chat/completions
AI_PROVIDER=openai-compatible
AI_BASE_URL=<对话模型根地址，如 https://xxx.example.com/v1>
AI_MODEL=<对话模型 ID>
AI_API_KEY=<对话模型 API Key>

# ---------- 向量模型（rag-service，知识向量化与检索）----------
# base-url 填兼容接口根地址，不带 /embeddings。与对话模型的 Key 通常是两个
EMBEDDING_BASE_URL=<向量模型根地址>
EMBEDDING_MODEL=<Embedding 模型 ID>
EMBEDDING_API_KEY=<向量模型 API Key>
# 必须与 ES 中现有知识索引的向量维度一致
EMBEDDING_DIMENSIONS=1024

# ---------- 可选项（一般不用改）----------
# 前端访问后端的来源（生产改成实际域名）
CORS_ORIGINS=http://localhost:5173
# 知识库 ES 索引名
ES_KNOWLEDGE_INDEX=knowledge_chunk
