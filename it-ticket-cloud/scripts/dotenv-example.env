# ============================================================
# IT 工单云 - 环境变量模板（双模式自适应）
# ============================================================
# 模式 A（默认）：连本机 localhost，已配置好无需任何设置
# 模式 B（Docker）：取消下面一行的注释，并把本机切换到容器
# ============================================================

# ---------- 模式 A: 本机开发（默认）----------
# 不需要任何环境变量，工程 yml 默认值就是 localhost:3306 / 127.0.0.1:8848

# ---------- 模式 B: docker compose ----------
# 在 it-ticket-cloud/ 目录下 docker compose up -d 起服务后，注入下面这些
#  - MYSQL_HOST=mysql             # docker-compose.yml 里 mysql 服务的 service 名
#  - MYSQL_PORT=3306
#  - MYSQL_USERNAME=root
#  - MYSQL_PASSWORD=root123
#  - NACOS_ADDR=nacos:8848         # docker-compose.yml 里 nacos 服务的 service 名:端口
#  - JWT_SECRET=it-ticket-dev-jwt-secret-key-32bytes-minimum!!

# PowerShell 临时注入示例（单次启动有效）：
#   $env:MYSQL_HOST="mysql"; $env:NACOS_ADDR="nacos:8848"; mvn -pl user-service spring-boot:run

# IDEA Run Configuration 里加：
#   Environment variables: MYSQL_HOST=mysql;NACOS_ADDR=nacos:8848
