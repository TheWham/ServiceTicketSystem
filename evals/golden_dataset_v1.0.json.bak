  },
  {
    "id": "GOLDEN-QA-005",
    "category": "数据存储与备份",
    "difficulty": "MEDIUM",
    "query": "文件被Shift+Delete永久删除且已清空回收站，如何恢复？恢复前要注意什么防止数据被覆盖？",
    "ground_truth_answer": "恢复前立即停止使用该磁盘/分区避免新数据覆盖；联系IT检查文件服务器的卷影副本（以前的版本）或快照恢复，也可用 Recuva 等数据恢复软件（恢复前先做磁盘镜像）。",
    "reference_chunk_ids": ["ITKB-STO-001#c2", "ITKB-STO-001#c3"],
    "expected_keywords": ["卷影副本", "停止", "Recuva"],
    "is_conflict_check": false,
    "is_adversarial": false
  },
  {
    "id": "GOLDEN-QA-006",
