  {
    "id": "GOLDEN-QA-011",
    "category": "网络连接",
    "difficulty": "EASY",
    "query": "局域网内多台电脑间歇性断网、提示IP地址冲突，IT工程师用什么机制防止员工私接路由器？",
    "ground_truth_answer": "私接路由器开启DHCP是常见根因；IT应在核心交换机启用DHCP Snooping防止私接DHCP服务器，并通过交换机ARP表定位冲突IP对应的设备端口。",
    "reference_chunk_ids": ["ITKB-NET-005#c3"],
    "expected_keywords": ["DHCP Snooping", "IP地址冲突"],
    "is_conflict_check": false,
    "is_adversarial": false
  },
  {
    "id": "GOLDEN-QA-012",
    "category": "系统修复",
    "difficulty": "EASY",
    "query": "电脑频繁蓝屏显示MEMORY_MANAGEMENT，员工如何自检内存？IT工程师用什么工具分析dump文件？",
    "ground_truth_answer": "员工运行 mdsched 启动Windows内存诊断自检内存；IT工程师用 MemTest86 深度检测内存，并用 BlueScreenView 分析蓝屏dump文件定位故障驱动。",
    "reference_chunk_ids": ["ITKB-SYS-001#c0", "ITKB-SYS-001#c2"],
    "expected_keywords": ["mdsched", "MemTest86"],
    "is_conflict_check": false,
    "is_adversarial": false
  },
