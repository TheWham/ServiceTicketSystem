{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "workflow-demo",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "workflow_demo.app:app",
        "--app-dir",
        "services/python-retrieval",
        "--host",
        "127.0.0.1",
        "--port",
        "8330"
      ],
      "port": 8330
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5175
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5176"
      ],
      "port": 5176,
      "autoPort": true
    }
  ]
}