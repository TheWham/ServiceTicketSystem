# 复制本文件为 .env 并填入真实 key（.env 已被 .gitignore 忽略，不会入库）
# 三类模型各自独立 base_url + key，可自由切换不同供应商、互不影响

# ---- LLM（对话/清洗）----
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://your-endpoint-here/v1
LLM_CHAT_MODEL=kimi-k3
LLM_CLEAN_MODEL=deepseek-v4-flash

# ---- Embedding（向量化）----
EMBED_API_KEY=sk-your-key-here
EMBED_BASE_URL=https://your-endpoint-here/v1
EMBED_MODEL=qwen3-embedding-8b

# ---- Rerank（重排）----
RERANK_API_KEY=sk-your-key-here
RERANK_BASE_URL=https://your-endpoint-here/v1
RERANK_MODEL=qwen3-reranker-8b
